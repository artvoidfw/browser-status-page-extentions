{
  "manifest_version": 3,
  "name": "VoidTab",
  "version": "1.0.0",
  "description": "Zərif, dinamik və tam ekran fərdiləşdirilə bilən yeni səhifə genişlənməsi.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "VoidTab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
